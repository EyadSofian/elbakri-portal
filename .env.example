PORT=3000
NODE_ENV=development

# PostgreSQL. On Railway do NOT paste a literal URL here — reference the
# Postgres service instead so the value follows password rotations:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Locally, point it at your own Postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elbakri?schema=public"

# Long random values, DIFFERENT from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your-super-secret-key-change-this
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=your-refresh-secret-change-this
REFRESH_TOKEN_EXPIRES_IN=30d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bookings@elbakri.com
SMTP_PASS=your-app-password
FROM_EMAIL="Elbakri Overseas <bookings@elbakri.com>"
INTERNAL_TEAM_EMAIL=team@elbakri.com

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_ID=

# Public origin of the deployment. Must be https:// and must NOT be localhost in
# production — the app refuses to boot otherwise. On Railway:
#   BASE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
BASE_URL=http://localhost:3000

# Storage directories (relative to the app root, or absolute).
# Public images are served at /uploads; private docs (passports, tickets) are
# stored separately and only reachable via the authenticated download route.
#
# IMPORTANT on Railway: the container filesystem is wiped on every deploy and
# restart. Attach a Volume and point all three at it, or uploaded images,
# passports and generated PDFs disappear on the next deploy. With a volume
# mounted at /data:
#   UPLOAD_DIR=/data/uploads
#   PRIVATE_UPLOAD_DIR=/data/uploads-private
#   PDF_DIR=/data/generated
UPLOAD_DIR=./uploads
# Optional — defaults to a sibling "uploads-private" dir next to UPLOAD_DIR.
# Never served statically.
PRIVATE_UPLOAD_DIR=./uploads-private
PDF_DIR=./generated

# Set to 1 to run the portal from fixtures with no database at all (preview
# only — nothing is saved). Leave unset for real deployments.
# DEMO_MODE=1
