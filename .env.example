PORT=3000
NODE_ENV=development

# PostgreSQL. On Railway, add a PostgreSQL service to the project and set this
# to a reference variable — ${{ Postgres.DATABASE_URL }} — so the private-network
# URL is injected and rotates with the database. Never paste the raw URL.
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME"

# Generate each of these with: openssl rand -base64 48
# They MUST be different from each other and must not stay at the values above.
JWT_SECRET=your-super-secret-key-change-this
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=your-refresh-secret-change-this
REFRESH_TOKEN_EXPIRES_IN=30d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bookings@elbakri.com
SMTP_PASS=your-app-password
FROM_EMAIL="Elbakri Overseas <bookings@elbakri.com>"
INTERNAL_TEAM_EMAIL=team@elbakri.com

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_ID=

# Public origin of the app. Also used as the allowed CORS origin, so it must be
# the exact scheme + host the browser uses — on Railway that is
# https://${{ RAILWAY_PUBLIC_DOMAIN }} (or your custom domain once attached).
BASE_URL=http://localhost:3000

# Storage directories (relative to the app root, or absolute).
# Public images are served at /uploads; private docs (passports, tickets) are
# stored separately and only reachable via the authenticated download route.
#
# IMPORTANT on Railway: the container filesystem is wiped on every deploy and
# restart. Attach a Volume (e.g. mounted at /data) and point all three of these
# at paths inside it — /data/uploads, /data/uploads-private, /data/generated —
# or every uploaded image, passport scan and generated PDF is lost on redeploy.
UPLOAD_DIR=./uploads
# Optional — defaults to a sibling "uploads-private" dir next to UPLOAD_DIR.
# Never served statically.
PRIVATE_UPLOAD_DIR=./uploads-private
PDF_DIR=./generated

# Preview mode: serves the whole API from fixtures, never touches the database.
# Leave unset (or 0) for any real deployment.
# DEMO_MODE=0
