# Railway (and any host) sets NODE_ENV=production on the service, and npm reads
# that as "omit dev dependencies" — which drops typescript and the build fails
# with `tsc: not found`. The build needs devDependencies: tsc compiles the app,
# and ts-node runs the seed scripts through `railway run`.
#
# `include=dev` is the non-deprecated form and takes precedence over both
# NODE_ENV=production and an NPM_CONFIG_PRODUCTION=true service variable, so the
# build does not depend on how the host is configured.
include=dev
