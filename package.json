{
  "name": "elbakri-portal",
  "version": "1.0.0",
  "description": "Elbakri Overseas B2B Travel Portal",
  "main": "dist/app.js",
  "engines": {
    "node": ">=18 <=20"
  },
  "scripts": {
    "dev": "nodemon --exec ts-node src/app.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "postinstall": "prisma generate",
    "test": "node -r ts-node/register/transpile-only -r ./tests/setup.ts --test tests/pricing.test.ts tests/wallet.test.ts",
    "test:integration": "node -r ts-node/register/transpile-only -r ./tests/setup.ts --test tests/integration.test.ts",
    "start": "node dist/app.js",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:mea": "ts-node prisma/seed-mea.ts",
    "db:seed:hotels": "ts-node prisma/seed-hotels.ts",
    "db:import:mea": "ts-node prisma/import-mea-workbook.ts",
    "db:apply:images": "ts-node prisma/apply-hotel-images.ts",
    "db:seed:destinations": "ts-node prisma/seed-destination-images.ts",
    "db:seed:airports": "ts-node prisma/seed-airports.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "googleapis": "^173.0.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.15.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.12.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.13.4",
    "nodemon": "^3.1.0",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
