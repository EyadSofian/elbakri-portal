generator client {
  provider = "prisma-client-js"
  // Ship engines for both the CI build host (Debian/Ubuntu) and typical GoDaddy
  // cPanel hosts (CloudLinux/CentOS = rhel). `node_modules` is built in CI and
  // FTP-uploaded, so the runtime engine must match the *server* OS, not the CI OS.
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  SUPERADMIN
  COMPANY_ADMIN
  AGENT
}

enum CompanyTier {
  STANDARD
  SILVER
  GOLD
  PLATINUM
}

// Client market / nationality bucket — drives which explicit price tier the
// company sees and its default display currency.
enum Market {
  EGYPTIAN
  INTERNATIONAL
  GULF
  FOREIGN
}

enum ServiceScope {
  ACTIVITY
  TRANSPORT
}

enum PricingAdjustmentType {
  NONE
  FIXED
  PERCENTAGE
}

enum HotelSource {
  MANUAL
  GOOGLE_SHEETS
}

enum RoomType {
  STANDARD
  DELUXE
  SUITE
  EXECUTIVE
}

enum BookingType {
  HOTEL
  FLIGHT
  PACKAGE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
  COMPLETED
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
  CANCELLED
}

enum TransactionType {
  CREDIT
  DEBIT
  REFUND
  ADJUSTMENT
}

enum SyncStatus {
  SUCCESS
  FAILED
  PARTIAL
  RUNNING
}

enum CabinClass {
  ECONOMY
  BUSINESS
  FIRST
}

enum Season {
  LOW
  REGULAR
  HIGH
  PEAK
}

enum ShipType {
  CRUISE
  DAHABIYA
  FELUCCA
}

enum CruiseRoute {
  LUXOR_ASWAN
  ASWAN_LUXOR
  LUXOR_ASWAN_LUXOR
}

enum CabinType {
  STANDARD
  DELUXE
  SUITE
  PRESIDENTIAL
}

enum TransportType {
  AIRPORT_TRANSFER
  PRIVATE_TRANSFER
  DAY_TOUR_TRANSPORT
  INTERCITY
}

// How a transport product is priced/consumed. Drives which booking fields the
// UI collects and how the backend validates the journey (see TransportRate /
// TransportBooking). Independent of the legacy `TransportType`.
enum TransportServiceMode {
  POINT_TO_POINT // explicit From → To (e.g. hotel → hotel)
  AIRPORT_TRANSFER // airport ⇄ hotel/address, flight details
  HOURLY_CHARTER // car at disposal for N hours (e.g. Cairo 8/12 Hours)
  DAY_USE // full-day disposal
}

enum VehicleType {
  SEDAN
  SUV
  VAN_6
  VAN_12
  MINIBUS_20
  BUS_45
  LUXURY_LIMO
}

enum ActivityCategory {
  SIGHTSEEING
  DIVING
  SNORKELING
  DESERT_SAFARI
  WATER_SPORTS
  CULTURAL
  FOOD_TOUR
  ADVENTURE
  RELAXATION
}

enum VisaType {
  TOURIST
  BUSINESS
  TRANSIT
  STUDENT
  MEDICAL
  UMRAH
  HAJJ
}

enum MealPlan {
  ROOM_ONLY
  BREAKFAST
  HALF_BOARD
  FULL_BOARD
  ALL_INCLUSIVE
  ULTRA_ALL_INCLUSIVE
}

enum ProcessingType {
  NORMAL
  EXPRESS
  URGENT
}

enum VisaStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum ReceptionType {
  MEET_AND_GREET
  AHLAN_SERVICE
  VIP_LOUNGE
  FULL_ASSISTANCE
}

enum EgyptAirport {
  CAI
  HRG
  SSH
  LXR
  ASW
  HBE
  MHH
}

// ─────────────────────────────────────────────
// NEW ENUMS (B2B Refactor)
// ─────────────────────────────────────────────

enum DestinationType {
  CITY
  RESORT
  AREA
  REGION
}

enum QuoteRequestStatus {
  NEW
  IN_REVIEW
  QUOTED
  ACCEPTED
  CLOSED
  CANCELLED
}

enum QuoteServiceType {
  HOTEL
  PACKAGE
  CRUISE
  FLIGHT
  MULTI_SERVICE
}

// Typed transport endpoint — replaces the old free-text "everything in one
// dropdown". A route leg is one of these kinds, with a soft id + display name.
enum TransportEndpointType {
  AIRPORT
  HOTEL
  DESTINATION
}

// How a hotel rate supplement behaves. TEXT_ONLY = informational (e.g. "Nile
// View"), FIXED_AMOUNT / PERCENTAGE = an actual surcharge.
enum HotelSupplementType {
  FIXED_AMOUNT
  PERCENTAGE
  TEXT_ONLY
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────

model User {
  id                          String                      @id @default(cuid())
  email                       String                      @unique
  password                    String
  name                        String
  nameAr                      String?
  role                        Role                        @default(AGENT)
  companyId                   String?
  company                     Company?                    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  bookings                    Booking[]                   @relation("BookingCreatedBy")
  transactions                WalletTransaction[]         @relation("TransactionCreatedBy")
  platformTransactions        PlatformWalletTransaction[] @relation("PlatformWalletTransactionCreatedBy")
  cruiseBookings              CruiseBooking[]             @relation("CruiseBookingCreatedBy")
  transportBookings           TransportBooking[]          @relation("TransportBookingCreatedBy")
  activityBookings            ActivityBooking[]           @relation("ActivityBookingCreatedBy")
  activityPackages            ActivityPackage[]           @relation("ActivityPackageCreatedBy")
  visaApplications            VisaApplication[]           @relation("VisaCreatedBy")
  airportReceptions           AirportReception[]          @relation("ReceptionCreatedBy")
  quoteRequests               QuoteRequest[]              @relation("QuoteRequestCreatedBy")
  assignedQuotes              QuoteRequest[]              @relation("QuoteRequestAssignedTo")
  simRequests                 SimRequest[]                @relation("SimRequestCreatedBy")
  // Lifecycle audit — bookings/requests this user confirmed (Phase 1)
  confirmedBookings           Booking[]                   @relation("BookingConfirmedBy")
  confirmedTransport          TransportBooking[]          @relation("TransportConfirmedBy")
  confirmedActivities         ActivityBooking[]           @relation("ActivityConfirmedBy")
  confirmedActivityPackages   ActivityPackage[]           @relation("ActivityPackageConfirmedBy")
  confirmedReceptions         AirportReception[]          @relation("ReceptionConfirmedBy")
  confirmedCruises            CruiseBooking[]             @relation("CruiseConfirmedBy")
  confirmedSims               SimRequest[]                @relation("SimConfirmedBy")
  confirmedVisas              VisaApplication[]           @relation("VisaConfirmedBy")
  confirmedQuotes             QuoteRequest[]              @relation("QuoteConfirmedBy")
  createdConsolidatedInvoices ConsolidatedInvoice[]       @relation("ConsolidatedInvoiceCreatedBy")
  refreshTokens               RefreshToken[]
  isActive                    Boolean                     @default(true)
  lastLoginAt                 DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  @@index([email])
  @@index([companyId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(500)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ─────────────────────────────────────────────
// COMPANIES
// ─────────────────────────────────────────────

model Company {
  id                   String                      @id @default(cuid())
  name                 String
  nameAr               String?
  email                String                      @unique
  contactEmail         String? // Separate contact email from admin user login email
  phone                String
  address              String?                     @db.Text
  billingAddress       String?                     @db.Text
  country              String                      @default("EG")
  taxId                String?
  website              String?
  creditLimit          Decimal                     @default(0) @db.Decimal(12, 2)
  balance              Decimal                     @default(0) @db.Decimal(12, 2)
  currency             String                      @default("USD")
  // Client market — picks the explicit per-market price tier (see MarketPrice)
  market               Market                      @default(INTERNATIONAL)
  tier                 CompanyTier                 @default(STANDARD)
  logoUrl              String?                     @db.Text
  themeColor           String?
  isActive             Boolean                     @default(true)
  lastActivityAt       DateTime?
  users                User[]
  bookings             Booking[]
  invoices             Invoice[]
  transactions         WalletTransaction[]
  platformTransactions PlatformWalletTransaction[]
  cruiseBookings       CruiseBooking[]
  transportBookings    TransportBooking[]
  activityBookings     ActivityBooking[]
  activityPackages     ActivityPackage[]
  visaApplications     VisaApplication[]
  airportReceptions    AirportReception[]
  quoteRequests        QuoteRequest[]
  simRequests          SimRequest[]
  consolidatedInvoices ConsolidatedInvoice[]
  hotelVisibility      HotelCompanyVisibility[]
  marketPrices         MarketPrice[]               @relation("CompanyMarketPrices")
  vouchers             Voucher[]
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  @@index([email])
}

// ─────────────────────────────────────────────
// DESTINATIONS (Dynamic, replaces ActivityCity enum)
// ─────────────────────────────────────────────

model Destination {
  id                String             @id @default(cuid())
  name              String
  nameAr            String?
  slug              String             @unique
  country           String             @default("EG")
  region            String?
  type              DestinationType    @default(CITY)
  imageUrl          String?            @db.Text
  imageAltEn        String?
  imageAltAr        String?
  galleryUrls       Json?
  isActive          Boolean            @default(true)
  hotels            Hotel[]
  activities        Activity[]
  transportRates    TransportRate[]
  quoteRequests     QuoteRequest[]
  serviceGroupTypes ServiceGroupType[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([slug])
  @@index([country])
  @@index([isActive])
}

// ─────────────────────────────────────────────
// HOTELS & ROOMS
// ─────────────────────────────────────────────

model Hotel {
  id                     String                   @id @default(cuid())
  name                   String
  nameAr                 String?
  city                   String
  cityAr                 String?
  country                String
  stars                  Int                      @default(3)
  address                String                   @db.Text
  description            String?                  @db.Text
  descriptionAr          String?                  @db.Text
  amenities              Json?
  // Sub-area within the city (e.g. Naama Bay, Nabq, Sahl Hasheesh)
  area                   String?
  // Structured attributes (synced from Verified_Hotels sheet) — drive agent filters
  seaFront               Boolean                  @default(false)
  privateBeach           Boolean                  @default(false)
  sandyBeach             Boolean                  @default(false)
  kidsPool               Boolean                  @default(false)
  kidsClub               Boolean                  @default(false)
  aquaPark               Boolean                  @default(false)
  snorkeling             Boolean                  @default(false)
  diving                 Boolean                  @default(false)
  adultsOnly             Boolean                  @default(false)
  allInclusive           Boolean                  @default(false)
  totalPools             Int?
  googleRating           Decimal?                 @db.Decimal(3, 2)
  imageUrl               String?                  @db.Text
  galleryUrls            Json?
  // Booking.com media enrichment (Apify) — see HotelMediaSyncLog
  bookingHotelId         String?
  bookingUrl             String?                  @db.Text
  bookingMatchedName     String?
  bookingMatchScore      Decimal?                 @db.Decimal(4, 3)
  mediaNeedsManualReview Boolean                  @default(false)
  mediaSyncedAt          DateTime?
  pricePerNight          Decimal                  @db.Decimal(10, 2)
  currency               String                   @default("USD")
  commissionPercent      Decimal                  @default(0) @db.Decimal(5, 2)
  availableRooms         Int                      @default(0)
  maxGuestsPerRoom       Int                      @default(2)
  // Price visibility controls
  showPriceToAgents      Boolean                  @default(false)
  allowQuoteRequest      Boolean                  @default(true)
  minVisibleTier         CompanyTier?
  // Structured hotel policies (shown in the company hotel detail modal)
  checkInTime            String?
  checkOutTime           String?
  cancellationPolicy     String?                  @db.Text
  cancellationPolicyAr   String?                  @db.Text
  childrenPolicy         String?                  @db.Text
  childrenPolicyAr       String?                  @db.Text
  extraBedPolicy         String?                  @db.Text
  extraBedPolicyAr       String?                  @db.Text
  mealPolicy             String?                  @db.Text
  mealPolicyAr           String?                  @db.Text
  importantNotes         String?                  @db.Text
  importantNotesAr       String?                  @db.Text
  source                 HotelSource              @default(MANUAL)
  sheetsRowId            String?
  isActive               Boolean                  @default(true)
  destinationId          String?
  destination            Destination?             @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  rooms                  Room[]
  bookings               Booking[]
  pricing                HotelPricing[]
  rates                  HotelRate[]
  quoteRequests          QuoteRequest[]
  companyVisibility      HotelCompanyVisibility[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([city])
  @@index([country])
  @@index([sheetsRowId])
  @@index([destinationId])
  @@index([bookingHotelId])
}

model Room {
  id            String    @id @default(cuid())
  hotelId       String
  hotel         Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  type          RoomType  @default(STANDARD)
  capacity      Int       @default(2)
  pricePerNight Decimal   @db.Decimal(10, 2)
  isAvailable   Boolean   @default(true)
  bookings      Booking[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([hotelId])
}

model HotelPricing {
  id            String   @id @default(cuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomType      RoomType
  season        Season   @default(REGULAR)
  pricePerNight Decimal  @db.Decimal(10, 2)
  currency      String   @default("USD")
  validFrom     DateTime
  validTo       DateTime
  sheetsRowId   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([hotelId])
  @@index([sheetsRowId])
}

// ─────────────────────────────────────────────
// HOTEL RATE MATRIX (structured, per-room, per-market, per-occupancy)
// ─────────────────────────────────────────────
// Replaces the simple single pricePerNight for hotels that have a proper rate
// table. Each row is one room type for one market with single/double/triple
// occupancy prices in an explicit currency (NO FX conversion). `market = null`
// means the row applies to ALL markets (fallback). Supplements hang off a row.
model HotelRate {
  id           String                @id @default(cuid())
  hotelId      String
  hotel        Hotel                 @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomName     String // free text — e.g. "Standard Room", "Deluxe Sea View"
  market       Market? // null = applies to ALL markets
  currency     String                @default("USD")
  singlePrice  Decimal?              @db.Decimal(10, 2)
  doublePrice  Decimal?              @db.Decimal(10, 2)
  triplePrice  Decimal?              @db.Decimal(10, 2)
  mealPlan     MealPlan?
  validFrom    DateTime?
  validTo      DateTime?
  isActive     Boolean               @default(true)
  notes        String?               @db.Text
  displayOrder Int                   @default(0)
  supplements  HotelRateSupplement[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([hotelId])
  @@index([hotelId, isActive])
}

model HotelRateSupplement {
  id           String              @id @default(cuid())
  rateId       String
  rate         HotelRate           @relation(fields: [rateId], references: [id], onDelete: Cascade)
  name         String // free text — e.g. "Sea View", "Extra Bed", "High Floor"
  type         HotelSupplementType @default(TEXT_ONLY)
  amount       Decimal?            @db.Decimal(10, 2)
  currency     String?
  notes        String?             @db.Text
  displayOrder Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([rateId])
}

model HotelCompanyVisibility {
  id              String   @id @default(cuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  canViewPrice    Boolean  @default(true)
  canRequestQuote Boolean?
  note            String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([hotelId, companyId])
  @@index([hotelId])
  @@index([companyId])
}

// ─────────────────────────────────────────────
// BOOKINGS (only for truly confirmable in-app services)
// ─────────────────────────────────────────────

model Booking {
  id                 String        @id @default(cuid())
  refNumber          String        @unique
  type               BookingType
  status             BookingStatus @default(PENDING)
  companyId          String
  company            Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdById        String
  createdBy          User          @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  hotelId            String?
  hotel              Hotel?        @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  roomId             String?
  room               Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  checkIn            DateTime?
  checkOut           DateTime?
  nights             Int?
  origin             String?
  destination        String?
  departureDate      DateTime?
  returnDate         DateTime?
  airline            String?
  flightNumber       String?
  cabinClass         CabinClass?
  passengerNames     Json?
  adultsCount        Int           @default(1)
  childrenCount      Int           @default(0)
  infantsCount       Int           @default(0)
  roomsCount         Int           @default(1)
  baseAmount         Decimal       @db.Decimal(12, 2)
  commissionPercent  Decimal       @default(0) @db.Decimal(5, 2)
  commissionAmount   Decimal       @default(0) @db.Decimal(12, 2)
  discount           Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  currency           String        @default("USD")
  sourceAmount       Decimal?      @db.Decimal(12, 2)
  sourceCurrency     String?
  exchangeRate       Decimal?      @db.Decimal(18, 8)
  exchangeRateAt     DateTime?
  notes              String?       @db.Text
  internalNotes      String?       @db.Text
  invoice            Invoice?
  requestedAt        DateTime      @default(now())
  confirmedAt        DateTime?
  confirmedById      String?
  confirmedBy        User?         @relation("BookingConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  cancelledAt        DateTime?
  cancellationReason String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([type])
  @@index([refNumber])
  @@index([createdAt])
  @@index([confirmedById])
}

model BookingCounter {
  year    Int @id
  lastSeq Int @default(0)
}

// ─────────────────────────────────────────────
// QUOTE REQUESTS (for hotel / package / cruise)
// ─────────────────────────────────────────────

model QuoteRequest {
  id                String             @id @default(cuid())
  refNumber         String             @unique
  serviceType       QuoteServiceType
  status            QuoteRequestStatus @default(NEW)
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdById       String
  createdBy         User               @relation("QuoteRequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  destinationId     String?
  destination       Destination?       @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  destinationName   String?
  hotelId           String?
  hotel             Hotel?             @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  // Service identity for non-hotel services (soft refs — no FK constraint for flexibility)
  serviceId         String? // cruiseId, activityId, or transportRateId as plain text
  serviceName       String? // Human-readable display name of the quoted service
  cruiseId          String? // NileCruise.id — soft reference
  activityId        String? // Activity.id — soft reference
  checkIn           DateTime?
  checkOut          DateTime?
  adultsCount       Int                @default(1)
  childrenCount     Int                @default(0)
  infantsCount      Int                @default(0)
  roomsCount        Int?
  nationality       String?
  travelFrom        String?
  mealPlan          MealPlan?
  childAges         Json?
  budget            Decimal?           @db.Decimal(12, 2)
  quotedAmount      Decimal?           @db.Decimal(12, 2)
  currency          String             @default("USD")
  customerNotes     String?            @db.Text
  internalNotes     String?            @db.Text
  contactPreference String?
  customFields      Json? // dynamic fields captured by the Request Form Builder template
  assignedToId      String?
  assignedTo        User?              @relation("QuoteRequestAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  respondedAt       DateTime?
  closedAt          DateTime?
  requestedAt       DateTime           @default(now())
  confirmedAt       DateTime?
  confirmedById     String?
  confirmedBy       User?              @relation("QuoteConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([serviceType])
  @@index([refNumber])
  @@index([createdAt])
  @@index([assignedToId])
  @@index([confirmedById])
}

model QuoteRequestCounter {
  year    Int @id
  lastSeq Int @default(0)
}

// ─────────────────────────────────────────────
// INVOICES
// ─────────────────────────────────────────────

model Invoice {
  id                 String                   @id @default(cuid())
  invoiceNumber      String                   @unique
  // bookingId is now optional — invoice may belong to activity or transport booking
  bookingId          String?                  @unique
  booking            Booking?                 @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  activityBookingId  String?                  @unique
  activityBooking    ActivityBooking?         @relation(fields: [activityBookingId], references: [id], onDelete: Restrict)
  activityPackageId  String?                  @unique
  activityPackage    ActivityPackage?         @relation(fields: [activityPackageId], references: [id], onDelete: Restrict)
  transportBookingId String?                  @unique
  transportBooking   TransportBooking?        @relation(fields: [transportBookingId], references: [id], onDelete: Restrict)
  airportReceptionId String?                  @unique
  airportReception   AirportReception?        @relation(fields: [airportReceptionId], references: [id], onDelete: Restrict)
  cruiseBookingId    String?                  @unique
  cruiseBooking      CruiseBooking?           @relation(fields: [cruiseBookingId], references: [id], onDelete: Restrict)
  visaApplicationId  String?                  @unique
  visaApplication    VisaApplication?         @relation(fields: [visaApplicationId], references: [id], onDelete: Restrict)
  simRequestId       String?                  @unique
  simRequest         SimRequest?              @relation(fields: [simRequestId], references: [id], onDelete: Restrict)
  companyId          String
  company            Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  subtotal           Decimal                  @db.Decimal(12, 2)
  taxRate            Decimal                  @default(0) @db.Decimal(5, 4)
  taxAmount          Decimal                  @db.Decimal(12, 2)
  total              Decimal                  @db.Decimal(12, 2)
  currency           String                   @default("USD")
  sourceSubtotal     Decimal?                 @db.Decimal(12, 2)
  sourceCurrency     String?
  exchangeRate       Decimal?                 @db.Decimal(18, 8)
  exchangeRateAt     DateTime?
  status             InvoiceStatus            @default(UNPAID)
  pdfPath            String?                  @db.Text
  dueDate            DateTime
  paidAt             DateTime?
  notes              String?                  @db.Text
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  consolidatedLine   ConsolidatedInvoiceLine?

  @@index([companyId])
  @@index([status])
}

model ConsolidatedInvoice {
  id              String                    @id @default(cuid())
  statementNumber String                    @unique
  companyId       String
  company         Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdById     String?
  createdBy       User?                     @relation("ConsolidatedInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  periodFrom      DateTime?
  periodTo        DateTime?
  subtotal        Decimal                   @db.Decimal(12, 2)
  total           Decimal                   @db.Decimal(12, 2)
  currency        String
  status          InvoiceStatus             @default(UNPAID)
  pdfPath         String?                   @db.Text
  notes           String?                   @db.Text
  lines           ConsolidatedInvoiceLine[]
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([createdAt])
}

model ConsolidatedInvoiceLine {
  id                    String              @id @default(cuid())
  consolidatedInvoiceId String
  consolidatedInvoice   ConsolidatedInvoice @relation(fields: [consolidatedInvoiceId], references: [id], onDelete: Cascade)
  invoiceId             String              @unique
  invoice               Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  invoiceNumber         String
  refNumber             String?
  service               String
  serviceDate           DateTime
  amount                Decimal             @db.Decimal(12, 2)
  currency              String
  status                InvoiceStatus
  createdAt             DateTime            @default(now())

  @@index([consolidatedInvoiceId])
}

model InvoiceCounter {
  year    Int @id
  lastSeq Int @default(0)
}

// ─────────────────────────────────────────────
// WALLET
// ─────────────────────────────────────────────

model WalletTransaction {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  balanceBefore Decimal         @db.Decimal(12, 2)
  balanceAfter  Decimal         @db.Decimal(12, 2)
  reference     String?
  description   String          @db.Text
  createdById   String
  createdBy     User            @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime        @default(now())

  @@index([companyId])
  @@index([createdAt])
}

model PlatformWallet {
  currency  String   @id @default("USD")
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformWalletTransaction {
  id            String          @id @default(cuid())
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  balanceBefore Decimal         @db.Decimal(12, 2)
  balanceAfter  Decimal         @db.Decimal(12, 2)
  currency      String          @default("USD")
  reference     String?
  description   String          @db.Text
  companyId     String?
  company       Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?           @relation("PlatformWalletTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  @@index([currency])
  @@index([companyId])
  @@index([createdById])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
