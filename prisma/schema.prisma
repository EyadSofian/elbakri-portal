// ─────────────────────────────────────────────
// HOTEL MEDIA ENRICHMENT (Booking.com via Apify)
// ─────────────────────────────────────────────

// ─────────────────────────────────────────────
// MARKET PRICING (explicit per-market price overrides)
// ─────────────────────────────────────────────
// The existing base price column on each service (Hotel.pricePerNight,
// Activity.priceAdult/priceChild, TransportRate.rate/roundTripRate,
// NileCruise.priceFrom, SimPackage.price) is treated as the international default.
// price. A MarketPrice row holds a per-market override (in USD). Resolution =
// override row when present, else the base column — so existing data keeps working.

// A flexible price-matrix row. The admin defines an explicit `amount` in an
// explicit `currency` — the resolver returns it verbatim with NO FX conversion
// of the sale price. Resolution priority for a given (entityType, entityId):
//   1. company-specific row (companyId set)            — highest
//   2. market-specific row (market set, companyId null)
//   3. "applies to all" row (market null, companyId null)
//   4. the service's own base column                   — lowest fallback
// `priceUsd` is the legacy column kept for back-compat reads (treated as USD).
model MarketPrice {
  id               String    @id @default(cuid())
  entityType       String // HOTEL | ACTIVITY_ADULT | ACTIVITY_CHILD | TRANSPORT | TRANSPORT_RT | CRUISE | SIM | SECURITY | AIRPORT
  entityId         String
  market           Market? // null = applies to all markets (still overridable per-company)
  companyId        String? // non-null = company-specific override (highest priority)
  company          Company?  @relation("CompanyMarketPrices", fields: [companyId], references: [id], onDelete: Cascade)
  label            String?
  currency         String    @default("USD")
  amount           Decimal?  @db.Decimal(12, 2) // authoritative sale price in `currency`
  priceUsd         Decimal?  @db.Decimal(12, 2) // legacy USD column (fallback when amount is null)
  nationalityGroup String?
  minPax           Int?
  maxPax           Int?
  validFrom        DateTime?
  validTo          DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([entityType, entityId, market, companyId])
  @@index([entityType, entityId])
  @@index([companyId])
}

// ─────────────────────────────────────────────
// FX RATE CACHE (live daily currency conversion, keyless provider)
// ─────────────────────────────────────────────

model FxRateCache {
  id        String   @id @default("latest")
  base      String   @default("USD")
  rates     Json
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// VOUCHERS (customer-facing, no price shown)
// ─────────────────────────────────────────────

model Voucher {
  id                 String            @id @default(cuid())
  voucherNumber      String            @unique
  serviceType        String // TRANSPORT | ACTIVITY | SECURITY_APPROVAL | AIRPORT_ASSIST | SIM_CARD
  // Only one relation populated per voucher (polymorphic)
  transportBookingId String?           @unique
  transportBooking   TransportBooking? @relation("VoucherTransport", fields: [transportBookingId], references: [id], onDelete: Restrict)
  activityBookingId  String?           @unique
  activityBooking    ActivityBooking?  @relation("VoucherActivity", fields: [activityBookingId], references: [id], onDelete: Restrict)
  activityPackageId  String?           @unique
  activityPackage    ActivityPackage?  @relation("VoucherActivityPackage", fields: [activityPackageId], references: [id], onDelete: Restrict)
  visaApplicationId  String?           @unique
  visaApplication    VisaApplication?  @relation("VoucherVisa", fields: [visaApplicationId], references: [id], onDelete: Restrict)
  airportReceptionId String?           @unique
  airportReception   AirportReception? @relation("VoucherReception", fields: [airportReceptionId], references: [id], onDelete: Restrict)
  simRequestId       String?           @unique
  simRequest         SimRequest?       @relation("VoucherSim", fields: [simRequestId], references: [id], onDelete: Restrict)
  companyId          String
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clientName         String?
  pdfPath            String?           @db.Text
  notes              String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([companyId])
  @@index([serviceType])
  @@index([createdAt])
}

model VoucherCounter {
  year    Int @id
  lastSeq Int @default(0)
}

model HotelMediaSyncLog {
