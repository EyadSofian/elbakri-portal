// ─────────────────────────────────────────────
// UI / FORM BUILDER (admin-controlled, schema-driven)
// ─────────────────────────────────────────────

model UiTemplate {
  id          String               @id @default(cuid())
  key         String               @unique
  name        String
  target      String // company_dashboard | hotel_request | activity_request | transport_booking | security_approval | airport_assist | sim_card | offer_popup
  serviceType String?
  langMode    String               @default("both") // en | ar | both
  version     Int                  @default(1)
  isActive    Boolean              @default(false)
  config      Json
  revisions   UiTemplateRevision[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([target])
  @@index([isActive])
}

model UiTemplateRevision {
  id          String     @id @default(cuid())
  templateId  String
  template    UiTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     Int
  config      Json
  createdById String?
  createdAt   DateTime   @default(now())

  @@index([templateId])
}

model SheetsConfig {
  id              String      @id @default("default")
  spreadsheetId   String?
  autoSyncEnabled Boolean     @default(false)
  cronExpression  String?
  lastTestAt      DateTime?
  lastTestStatus  SyncStatus?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model SyncLog {
  id            String     @id @default(cuid())
  entity        String
  sheetName     String
  spreadsheetId String?
  status        SyncStatus
  synced        Int        @default(0)
  created       Int        @default(0)
  updated       Int        @default(0)
  skipped       Int        @default(0)
  errors        Json?
  triggeredById String?
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  createdAt     DateTime   @default(now())

  @@index([entity])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// HOTEL MEDIA ENRICHMENT (Booking.com via Apify)
// ─────────────────────────────────────────────

// ─────────────────────────────────────────────
// MARKET PRICING (explicit per-market price overrides)
// ─────────────────────────────────────────────
// The existing base price column on each service (Hotel.pricePerNight,
// Activity.priceAdult/priceChild, TransportRate.rate/roundTripRate,
// NileCruise.priceFrom, SimPackage.price) is treated as the international default.
// price. A MarketPrice row holds a per-market override (in USD). Resolution =
// override row when present, else the base column — so existing data keeps working.

model MarketPrice {
  id         String   @id @default(cuid())
  entityType String // HOTEL | ACTIVITY_ADULT | ACTIVITY_CHILD | TRANSPORT | TRANSPORT_RT | CRUISE | SIM
  entityId   String
  market     Market
  priceUsd   Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, market])
  @@index([entityType, entityId])
}

// ─────────────────────────────────────────────
// FX RATE CACHE (live daily currency conversion, keyless provider)
// ─────────────────────────────────────────────

model FxRateCache {
  id        String   @id @default("latest")
  base      String   @default("USD")
  rates     Json
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HotelMediaSyncLog {
  id            String     @id @default(cuid())
  stage         String // discover | fetch | sync
  city          String?
  actorId       String?
  dryRun        Boolean    @default(true)
  status        SyncStatus @default(RUNNING)
  total         Int        @default(0)
  matched       Int        @default(0)
  manualReview  Int        @default(0)
  applied       Int        @default(0)
  skipped       Int        @default(0)
  errors        Int        @default(0)
  photoRows     Int        @default(0)
  triggeredById String?
  notes         String?
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  createdAt     DateTime   @default(now())

  @@index([stage])
  @@index([status])
  @@index([createdAt])
}
