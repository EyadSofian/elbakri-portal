// ─────────────────────────────────────────────
// SIM CARD
// ─────────────────────────────────────────────

model SimPackage {
  id        String       @id @default(cuid())
  name      String
  nameAr    String?
  dataSize  String
  minutes   String?
  validity  String
  price     Decimal      @db.Decimal(10, 2)
  currency  String       @default("USD")
  isActive  Boolean      @default(true)
  requests  SimRequest[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([isActive])
}

model SimRequest {
  id             String        @id @default(cuid())
  refNumber      String        @unique
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  createdById    String
  createdBy      User          @relation("SimRequestCreatedBy", fields: [createdById], references: [id])
  packageId      String?
  package        SimPackage?   @relation(fields: [packageId], references: [id], onDelete: SetNull)
  clientName     String
  phone          String
  quantity       Int           @default(1)
  unitAmount     Decimal?      @db.Decimal(10, 2) // explicit unit price snapshot (no FX); total = unitAmount × quantity
  arrivalDate    DateTime?
  notes          String?       @db.Text
  customFields   Json? // dynamic fields captured by the Request Form Builder template
  invoice        Invoice?
  status         BookingStatus @default(PENDING)
  totalAmount    Decimal       @db.Decimal(12, 2)
  currency       String        @default("USD")
  sourceAmount   Decimal?      @db.Decimal(12, 2)
  sourceCurrency String?
  exchangeRate   Decimal?      @db.Decimal(18, 8)
  exchangeRateAt DateTime?
  requestedAt    DateTime      @default(now())
  confirmedAt    DateTime?
  confirmedById  String?
  confirmedBy    User?         @relation("SimConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  voucher        Voucher?      @relation("VoucherSim")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([confirmedById])
}

// ─────────────────────────────────────────────
// UI / FORM BUILDER (admin-controlled, schema-driven)
// ─────────────────────────────────────────────

model UiTemplate {
  id          String               @id @default(cuid())
  key         String               @unique
  name        String
  target      String // company_dashboard | hotel_request | activity_request | transport_booking | security_approval | airport_assist | sim_card | offer_popup
  serviceType String?
  langMode    String               @default("both") // en | ar | both
  version     Int                  @default(1)
  isActive    Boolean              @default(false)
  config      Json
  revisions   UiTemplateRevision[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([target])
  @@index([isActive])
}

