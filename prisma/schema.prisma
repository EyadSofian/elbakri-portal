// ─────────────────────────────────────────────
// TRANSPORT
// ─────────────────────────────────────────────

model TransportBooking {
  id                     String                @id @default(cuid())
  refNumber              String                @unique
  companyId              String
  company                Company               @relation(fields: [companyId], references: [id])
  createdById            String
  createdBy              User                  @relation("TransportBookingCreatedBy", fields: [createdById], references: [id])
  type                   TransportType
  serviceMode            TransportServiceMode?
  rateId                 String? // authoritative priced product — never match a booking to a price by display text
  rate                   TransportRate?        @relation(fields: [rateId], references: [id], onDelete: SetNull)
  matchedDirection       String? // EXACT | REVERSED — how the rate matched the requested route
  vehicleType            VehicleType           @default(SEDAN)
  // Denormalized route summary (back-compat). The structured fields below are authoritative.
  fromLocation           String
  toLocation             String
  fromType               String? // AIRPORT | DESTINATION | HOTEL (legacy)
  toType                 String? // AIRPORT | DESTINATION | HOTEL (legacy)
  // Actual outbound journey — captured independently of the rate's display labels.
  pickupType             String? // AIRPORT | HOTEL | ADDRESS | LANDMARK
  pickupLocation         String?
  pickupAddress          String?               @db.Text
  pickupHotelName        String? // required when pickupType = HOTEL (or hourly/day-use pickup)
  dropoffType            String? // AIRPORT | HOTEL | ADDRESS | LANDMARK
  dropoffLocation        String?
  dropoffAddress         String?               @db.Text
  dropoffHotelName       String? // required when dropoffType = HOTEL
  pickupDateTime         DateTime
  returnDateTime         DateTime?
  isRoundTrip            Boolean               @default(false)
  sameRouteReversed      Boolean               @default(true) // true = return is the outbound reversed (convenience default; unlock to capture a different return)
  // Return leg (independent — only populated when isRoundTrip = true)
  returnFromLocation     String?
  returnToLocation       String?
  returnFromType         String?
  returnToType           String?
  returnPickupHotelName  String?
  returnPickupAddress    String?               @db.Text
  returnDropoffHotelName String?
  returnDropoffAddress   String?               @db.Text
  passengerCount         Int                   @default(1)
  passengerNames         Json?
  passengerName          String? // lead passenger name
  flightNumber           String?
  airlineName            String?
  returnFlightNumber     String?
  returnAirlineName      String?
  contactNumber          String?
  groupTypeId            String?
  groupType              ServiceGroupType?     @relation("TransportBookingGroupType", fields: [groupTypeId], references: [id], onDelete: SetNull)
  groupTypeLabel         String?
  totalAmount            Decimal               @db.Decimal(12, 2)
  currency               String                @default("USD")
  sourceAmount           Decimal?              @db.Decimal(12, 2)
  sourceCurrency         String?
  exchangeRate           Decimal?              @db.Decimal(18, 8)
  exchangeRateAt         DateTime?
  status                 BookingStatus         @default(PENDING)
  notes                  String?               @db.Text
  customFields           Json? // dynamic fields captured by the Request Form Builder template
  invoice                Invoice?
  voucher                Voucher?              @relation("VoucherTransport")
  requestedAt            DateTime              @default(now())
  confirmedAt            DateTime?
  confirmedById          String?
  confirmedBy            User?                 @relation("TransportConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([confirmedById])
  @@index([groupTypeId])
  @@index([rateId])
}

model TransportRate {
  id                String                 @id @default(cuid())
  sheetsRowId       String?
  type              TransportType          @default(PRIVATE_TRANSFER)
  // Priced-product descriptor — drives the service-aware UI + backend validation.
  serviceMode       TransportServiceMode   @default(POINT_TO_POINT)
  serviceNameEn     String?
  serviceNameAr     String?
  serviceArea       String? // e.g. "Cairo", "Sharm El Sheikh"
  durationHours     Int? // hours the car is at disposal (HOURLY_CHARTER / DAY_USE)
  vehicleType       VehicleType            @default(SEDAN)
  city              String?
  // Legacy free-text endpoints (kept for back-compat reads).
  fromLocation      String?
  toLocation        String?
  // Typed endpoints — authoritative. fromId/toId are soft refs (airportId,
  // hotelId or destinationId depending on the type); from/toName denormalize
  // the display label so a route resolves without extra joins.
  fromType          TransportEndpointType?
  fromId            String?
  fromName          String?
  toType            TransportEndpointType?
  toId              String?
  toName            String?
  // If true, this rate also prices the reverse direction (B → A) at the same price.
  isBidirectional   Boolean                @default(false)
  rate              Decimal                @db.Decimal(10, 2) // legacy one-way rate (back-compat)
  roundTripRate     Decimal?               @db.Decimal(10, 2) // legacy round-trip rate
  // Explicit dual-currency sale prices (NO FX). Egyptian market → EGP, others → USD.
  priceEgp          Decimal?               @db.Decimal(10, 2)
  priceUsd          Decimal?               @db.Decimal(10, 2)
  roundTripPriceEgp Decimal?               @db.Decimal(10, 2)
  roundTripPriceUsd Decimal?               @db.Decimal(10, 2)
  currency          String                 @default("USD")
  minCapacity       Int                    @default(1)
  maxCapacity       Int?
  notes             String?                @db.Text
  isActive          Boolean                @default(true)
  destinationId     String?
  destination       Destination?           @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  serviceGroupTypes ServiceGroupType[]
  bookings          TransportBooking[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([sheetsRowId])
  @@index([type])
  @@index([serviceMode])
  @@index([vehicleType])
  @@index([destinationId])
  @@index([fromType, fromId])
  @@index([toType, toId])
}

// ─────────────────────────────────────────────
// AIRPORTS (admin-managed — replaces the fixed EgyptAirport enum for transport)
// ─────────────────────────────────────────────
model Airport {
  id        String   @id @default(cuid())
  code      String   @unique // IATA-style code, e.g. CAI, HRG, SSH
  nameEn    String
  nameAr    String?
  city      String?
  cityAr    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ─────────────────────────────────────────────
// ACTIVITIES
// ─────────────────────────────────────────────

model Activity {
  id                 String                @id @default(cuid())
  name               String
  nameAr             String?
  // city is now free-text (replaces ActivityCity enum) — dynamic destinations
  city               String
  category           ActivityCategory      @default(SIGHTSEEING)
  duration           String?
  timeSlots          Json? // e.g. ["09:00 AM","02:00 PM"]
  description        String?               @db.Text
  descriptionAr      String?               @db.Text
  includes           Json?
  excludes           Json?
  imageUrl           String?               @db.Text
  priceAdult         Decimal               @db.Decimal(10, 2)
  priceChild         Decimal               @db.Decimal(10, 2)
  currency           String                @default("USD")
  sheetsRowId        String?
  minPax             Int                   @default(1)
  maxPax             Int                   @default(20)
  isActive           Boolean               @default(true)
  // If false, creates a quote request instead of a confirmed booking
  isConfirmableInApp Boolean               @default(true)
  destinationId      String?
  destination        Destination?          @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  bookings           ActivityBooking[]
  packageItems       ActivityPackageItem[]
  serviceGroupTypes  ServiceGroupType[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([city])
  @@index([sheetsRowId])
  @@index([destinationId])
}

// ─────────────────────────────────────────────
// ACTIVITY PACKAGES (one package = many activity line items, one voucher)
// ─────────────────────────────────────────────

model ActivityPackage {
  id             String                @id @default(cuid())
  refNumber      String                @unique // PKG-YYYY-NNNN
  companyId      String
  company        Company               @relation(fields: [companyId], references: [id])
  createdById    String
  createdBy      User                  @relation("ActivityPackageCreatedBy", fields: [createdById], references: [id])
  clientName     String?
  clientPhone    String?
  hotelName      String?
  adultsCount    Int                   @default(1)
  childrenCount  Int                   @default(0)
  childAges      Json?
  notes          String?               @db.Text // general package notes
  totalAmount    Decimal               @db.Decimal(12, 2)
  currency       String                @default("USD")
  sourceAmount   Decimal?              @db.Decimal(12, 2)
  sourceCurrency String?
  exchangeRate   Decimal?              @db.Decimal(18, 8)
  exchangeRateAt DateTime?
  status         BookingStatus         @default(PENDING)
  customFields   Json?
  items          ActivityPackageItem[]
  invoice        Invoice?
  voucher        Voucher?              @relation("VoucherActivityPackage")
  requestedAt    DateTime              @default(now())
  confirmedAt    DateTime?
  confirmedById  String?
  confirmedBy    User?                 @relation("ActivityPackageConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([confirmedById])
}

model ActivityPackageItem {
  id               String          @id @default(cuid())
  packageId        String
  package          ActivityPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  activityId       String
  activity         Activity        @relation(fields: [activityId], references: [id])
  activityName     String // snapshot of activity name at booking time
  city             String?
  activityDate     DateTime
  selectedTime     String?
  endTime          String? // optional — used for time-conflict validation
  adultsCount      Int             @default(1)
  childrenCount    Int             @default(0)
  childAges        Json?
  hotelName        String?
  clientPhone      String?
  activityType     String?
  groupTypeId      String?
  groupTypeLabel   String?
  transferIncluded Boolean?
  notes            String?         @db.Text
  lineAmount       Decimal?        @db.Decimal(12, 2) // internal — never shown on voucher
  currency         String          @default("USD")
  displayOrder     Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([packageId])
  @@index([activityId])
}

model ActivityPackageCounter {
  year    Int @id
  lastSeq Int @default(0)
}

model ActivityBooking {
  id             String            @id @default(cuid())
  refNumber      String            @unique
  activityId     String
  activity       Activity          @relation(fields: [activityId], references: [id])
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id])
  createdById    String
  createdBy      User              @relation("ActivityBookingCreatedBy", fields: [createdById], references: [id])
  activityDate   DateTime
  selectedTime   String? // time slot chosen by user e.g. "09:00 AM"
  activityType   String? // GROUP | PRIVATE | VIP
  groupTypeId    String?
  groupType      ServiceGroupType? @relation("ActivityBookingGroupType", fields: [groupTypeId], references: [id], onDelete: SetNull)
  groupTypeLabel String?
  adultsCount    Int               @default(1)
  childrenCount  Int               @default(0)
  childAges      Json? // array of child ages
  clientName     String? // lead client name
  clientPhone    String?
  hotelName      String?
  passengerNames Json?
  totalAmount    Decimal           @db.Decimal(12, 2)
  currency       String            @default("USD")
  sourceAmount   Decimal?          @db.Decimal(12, 2)
  sourceCurrency String?
  exchangeRate   Decimal?          @db.Decimal(18, 8)
  exchangeRateAt DateTime?
  status         BookingStatus     @default(PENDING)
  notes          String?           @db.Text
  invoice        Invoice?
  voucher        Voucher?          @relation("VoucherActivity")
  requestedAt    DateTime          @default(now())
  confirmedAt    DateTime?
  confirmedById  String?
  confirmedBy    User?             @relation("ActivityConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([companyId])
  @@index([activityId])
  @@index([confirmedById])
  @@index([groupTypeId])
}

model ServiceGroupType {
  id                String                @id @default(cuid())
  scope             ServiceScope
  code              String
  labelEn           String
  labelAr           String?
  descriptionEn     String?               @db.Text
  descriptionAr     String?               @db.Text
  destinationId     String?
  destination       Destination?          @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  activityId        String?
  activity          Activity?             @relation(fields: [activityId], references: [id], onDelete: Cascade)
  transportRateId   String?
  transportRate     TransportRate?        @relation(fields: [transportRateId], references: [id], onDelete: Cascade)
  adjustmentType    PricingAdjustmentType @default(NONE)
  adjustmentValue   Decimal               @default(0) @db.Decimal(12, 2)
  minPax            Int                   @default(1)
  maxPax            Int?
  isActive          Boolean               @default(true)
  displayOrder      Int                   @default(0)
  validFrom         DateTime?
  validTo           DateTime?
  activityBookings  ActivityBooking[]     @relation("ActivityBookingGroupType")
  transportBookings TransportBooking[]    @relation("TransportBookingGroupType")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([scope, code, destinationId, activityId, transportRateId])
  @@index([scope, isActive])
  @@index([destinationId])
  @@index([activityId])
  @@index([transportRateId])
}

// ─────────────────────────────────────────────
// VISA
// ─────────────────────────────────────────────

model VisaApplication {
  id                 String         @id @default(cuid())
  refNumber          String         @unique
  companyId          String
  company            Company        @relation(fields: [companyId], references: [id])
  createdById        String
  createdBy          User           @relation("VisaCreatedBy", fields: [createdById], references: [id])
  applicantName      String
  nationality        String
  passportNumber     String
  passportExpiry     DateTime
  visaType           VisaType
  destinationCountry String
  travelDate         DateTime
  processingType     ProcessingType @default(NORMAL)
  status             VisaStatus     @default(PENDING)
  totalAmount        Decimal        @db.Decimal(12, 2)
  currency           String         @default("USD")
  sourceAmount       Decimal?       @db.Decimal(12, 2)
  sourceCurrency     String?
  exchangeRate       Decimal?       @db.Decimal(18, 8)
  exchangeRateAt     DateTime?
  notes              String?        @db.Text
  phone              String?
  hotelName          String?
  comingFrom         String? // origin country/city — printed on the security voucher
  flightNumber       String? // arrival flight number — printed on the security voucher
  arrivalTime        DateTime? // arrival date/time — printed on the security voucher
  paxCount           Int            @default(1)
  passportUrl        String?        @db.Text
  flightTicketUrl    String?        @db.Text
  customFields       Json? // dynamic fields captured by the Request Form Builder template
  invoice            Invoice?
  submittedAt        DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?        @db.Text
  requestedAt        DateTime       @default(now())
  confirmedAt        DateTime?
